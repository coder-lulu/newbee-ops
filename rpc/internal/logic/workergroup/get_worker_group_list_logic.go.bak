package workergroup

import (
	"context"
	"time"

	"github.com/coder-lulu/newbee-ops-rpc/ent/workergroup"
	"github.com/coder-lulu/newbee-ops-rpc/ent/predicate"
	"github.com/coder-lulu/newbee-ops-rpc/internal/svc"
	"github.com/coder-lulu/newbee-ops-rpc/internal/utils/dberrorhandler"
	"github.com/coder-lulu/newbee-ops-rpc/types/ops"

	"github.com/suyuan32/simple-admin-common/utils/pointy"
    "github.com/zeromicro/go-zero/core/logx"
)

type GetWorkerGroupListLogic struct {
	ctx    context.Context
	svcCtx *svc.ServiceContext
	logx.Logger
}

func NewGetWorkerGroupListLogic(ctx context.Context, svcCtx *svc.ServiceContext) *GetWorkerGroupListLogic {
	return &GetWorkerGroupListLogic{
		ctx:    ctx,
		svcCtx: svcCtx,
		Logger: logx.WithContext(ctx),
	}
}

func (l *GetWorkerGroupListLogic) GetWorkerGroupList(in *ops.WorkerGroupListReq) (*ops.WorkerGroupListResp, error) {
	var predicates []predicate.WorkerGroup
	if in.CreatedAt != nil {
		predicates = append(predicates, workergroup.CreatedAtGTE(time.UnixMilli(*in.CreatedAt)))
	}
	if in.UpdatedAt != nil {
		predicates = append(predicates, workergroup.UpdatedAtGTE(time.UnixMilli(*in.UpdatedAt)))
	}
	if in.Status != nil {
		predicates = append(predicates, workergroup.StatusEQ(uint8(*in.Status)))
	}
	if in.Name != nil {
		predicates = append(predicates, workergroup.NameContains(*in.Name))
	}
	if in.SelectionStrategy != nil {
		predicates = append(predicates, workergroup.SelectionStrategyEQ(workergroup.SelectionStrategy(*in.SelectionStrategy)))
	}

	result, err := l.svcCtx.DB.WorkerGroup.Query().Where(predicates...).Page(l.ctx, in.Page, in.PageSize)

	if err != nil {
		return nil, dberrorhandler.DefaultEntError(l.Logger, err, in)
	}

	resp := &ops.WorkerGroupListResp{}
	resp.Total = result.PageDetails.Total

	for _, v := range result.List {
		resp.Data = append(resp.Data, &ops.WorkerGroupInfo{
			Id:                  &v.ID,
			CreatedAt:           pointy.GetPointer(v.CreatedAt.Unix()),
			UpdatedAt:           pointy.GetPointer(v.UpdatedAt.Unix()),
			Status:              pointy.GetPointer(uint32(v.Status)),
			Name:                &v.Name,
			Description:         &v.Description,
			SelectionStrategy:   pointy.GetPointer(string(v.SelectionStrategy)),
			HealthCheckInterval: pointy.GetPointer(int32(v.HealthCheckInterval)),
			AutoFailover:        &v.AutoFailover,
			MaxRetryCount:       pointy.GetPointer(int32(v.MaxRetryCount)),
			MinHealthyWorkers:   pointy.GetPointer(int32(v.MinHealthyWorkers)),
			TotalMembers:        pointy.GetPointer(int32(v.TotalMembers)),
			OnlineMembers:       pointy.GetPointer(int32(v.OnlineMembers)),
			TotalWeight:         pointy.GetPointer(int32(v.TotalWeight)),
		})
	}

	return resp, nil
}
