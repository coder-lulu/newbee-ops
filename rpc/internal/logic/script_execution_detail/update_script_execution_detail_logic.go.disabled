package script_execution_detail

import (
	"context"

	"github.com/coder-lulu/newbee-ops-rpc/internal/svc"
	"github.com/coder-lulu/newbee-ops-rpc/internal/utils/dberrorhandler"
	"github.com/coder-lulu/newbee-ops-rpc/types/ops"

    "github.com/suyuan32/simple-admin-common/msg/errormsg"

	"github.com/suyuan32/simple-admin-common/utils/pointy"
	"github.com/zeromicro/go-zero/core/logx"
)

type UpdateScriptExecutionDetailLogic struct {
	ctx    context.Context
	svcCtx *svc.ServiceContext
	logx.Logger
}

func NewUpdateScriptExecutionDetailLogic(ctx context.Context, svcCtx *svc.ServiceContext) *UpdateScriptExecutionDetailLogic {
	return &UpdateScriptExecutionDetailLogic{
		ctx:    ctx,
		svcCtx: svcCtx,
		Logger: logx.WithContext(ctx),
	}
}

func (l *UpdateScriptExecutionDetailLogic) UpdateScriptExecutionDetail(in *ops.ScriptExecutionDetailInfo) (*ops.BaseResp, error) {
	query:= l.svcCtx.DB.ScriptExecutionDetail.UpdateOneID(*in.Id).
			SetNotNilExecutionID(in.ExecutionId).
			SetNotNilCiID(in.CiId).
			SetNotNilCiName(in.CiName).
			SetNotNilCiIP(in.CiIp).
			SetNotNilExecStatus(in.ExecStatus).
			SetNotNilStartedAt(pointy.GetTimeMilliPointer(in.StartedAt)).
			SetNotNilCompletedAt(pointy.GetTimeMilliPointer(in.CompletedAt)).
			SetNotNilDurationMs(in.DurationMs).
			SetNotNilOutput(in.Output).
			SetNotNilErrorOutput(in.ErrorOutput).
			SetNotNilFullOutputPath(in.FullOutputPath).
			SetNotNilTaskID(in.TaskId).
			SetNotNilWorkerID(in.WorkerId).
			SetNotNilProxyID(in.ProxyId).
			SetNotNilErrorMessage(in.ErrorMessage).
			SetNotNilRetryCount(in.RetryCount)

	if in.Status != nil {
		query.SetNotNilStatus(pointy.GetPointer(uint8(*in.Status)))
	}
	if in.ExitCode != nil {
		query.SetNotNilExitCode(pointy.GetPointer(int(*in.ExitCode)))
	}

	 err := query.Exec(l.ctx)

    if err != nil {
		return nil, dberrorhandler.DefaultEntError(l.Logger, err, in)
	}

    return &ops.BaseResp{Msg: errormsg.UpdateSuccess }, nil
}
