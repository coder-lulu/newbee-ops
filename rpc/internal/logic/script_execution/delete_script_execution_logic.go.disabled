package script_execution

import (
	"context"

	"github.com/coder-lulu/newbee-ops-rpc/ent/scriptexecution"
	"github.com/coder-lulu/newbee-ops-rpc/internal/svc"
	"github.com/coder-lulu/newbee-ops-rpc/internal/utils/dberrorhandler"
	"github.com/coder-lulu/newbee-ops-rpc/types/ops"

	"github.com/suyuan32/simple-admin-common/msg/errormsg"
	"github.com/zeromicro/go-zero/core/logx"
)

type DeleteScriptExecutionLogic struct {
	ctx    context.Context
	svcCtx *svc.ServiceContext
	logx.Logger
}

func NewDeleteScriptExecutionLogic(ctx context.Context, svcCtx *svc.ServiceContext) *DeleteScriptExecutionLogic {
	return &DeleteScriptExecutionLogic{
		ctx:    ctx,
		svcCtx: svcCtx,
		Logger: logx.WithContext(ctx),
	}
}

func (l *DeleteScriptExecutionLogic) DeleteScriptExecution(in *ops.IDsReq) (*ops.BaseResp, error) {
	_, err := l.svcCtx.DB.ScriptExecution.Delete().Where(scriptexecution.IDIn(in.Ids...)).Exec(l.ctx)

	if err != nil {
		return nil, dberrorhandler.DefaultEntError(l.Logger, err, in)
	}

	return &ops.BaseResp{Msg: errormsg.DeleteSuccess}, nil
}
