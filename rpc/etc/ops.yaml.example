# Copy this file to ops.yaml and configure local values or environment variables.
Name: ops-rpc
ListenOn: 0.0.0.0:9600
Timeout: 30000

# 首次空库部署保持关闭；调用 initDatabase 成功后设为 true 并重启 RPC。
WorkerManager:
  Enabled: false

# gRPC服务器配置
ServerOptions:
  # 启用拦截器
  Interceptors: true

# Core服务RPC连接配置
CoreRpc:
  Endpoints:
    - 127.0.0.1:9100
  Timeout: 30000  # 30秒超时，单位：毫秒

Log:
  ServiceName: ops-rpc
  Mode: console
  Level: info

DatabaseConf:
  Type: mysql
  Host: 192.168.10.100
  Port: 13306
  DBName: newbee
  Username: root
  Password: "${OPS_CENTER_RPC_ETC_OPS_YAML_PASSWORD}"
  MaxOpenConn: 100
  SSLMode: disable
  CacheTime: 5

RedisConf:
  Host: 192.168.10.100:26739
  Pass: "123456"
  Db: 0
